generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users     User[]

  @@map("roles")
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String           @unique
  passwordHash    String?          @map("password_hash")
  roleId          String           @map("role_id") @db.Uuid
  role            Role             @relation(fields: [roleId], references: [id])
  isActive        Boolean          @default(false) @map("is_active")
  customerProfile CustomerProfile?
  artistProfile   ArtistProfile?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([roleId])
  @@map("users")
}

model CustomerProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String   @map("full_name")
  location         String
  customerType     String   @map("customer_type")
  reasonForBooking String   @map("reason_for_booking")
  businessName     String?  @map("business_name")
  mobileNumber     String   @map("mobile_number")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customer_profiles")
}

enum VerificationStatus {
  unverified
  verified
  rejected
}

enum KycStatus {
  not_started
  pending
  success
  failed
}

model ArtistProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileNumber       String             @map("mobile_number")

  // Who you are
  stageName          String?            @map("stage_name")
  legalName          String?            @map("legal_name")
  baseCity           String?            @map("base_city")
  stateName          String?            @map("state_name")
  currentCity        String?            @map("current_city")
  currentState       String?            @map("current_state")
  preferredCities    String[]           @default([]) @map("preferred_cities")
  preferredStates    String[]           @default([]) @map("preferred_states")
  discipline         String?
  subcategory        String?
  bio                String?
  instagram          String?

  // Pricing
  rateInr            Int?               @map("rate_inr")
  pricingUnit        String             @default("hour") @map("pricing_unit")
  travelSetting      String             @default("including") @map("travel_setting")
  travelChargeInr    Int                @default(0) @map("travel_charge_inr")
  stayChargeInr      Int                @default(0) @map("stay_charge_inr")
  cityRates          Json               @default("{}") @map("city_rates")

  // Media paths (S3 object keys later; local uploads for now)
  photoPath          String?            @map("photo_path")
  artPhotoPath       String?            @map("art_photo_path")
  faceVideoPath      String?            @map("face_video_path")
  reels              String[]           @default([])
  primaryReel        Int                @default(0) @map("primary_reel")

  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason")

  // Surepass Digilocker KYC (separate from admin verificationStatus)
  kycStatus          KycStatus          @default(not_started) @map("kyc_status")
  kycClientId        String?            @map("kyc_client_id")
  kycVerifiedName    String?            @map("kyc_verified_name")
  kycMaskedAadhaar   String?            @map("kyc_masked_aadhaar")
  kycDob             String?            @map("kyc_dob")
  kycGender          String?            @map("kyc_gender")
  kycVerifiedAt      DateTime?          @map("kyc_verified_at") @db.Timestamptz(6)
  kycRaw             Json?              @map("kyc_raw")

  // Bank / payout (submitted with profile; returned on admin APIs only)
  bankAccountHolder  String?            @map("bank_account_holder")
  bankName           String?            @map("bank_name")
  bankAccountNumber  String?            @map("bank_account_number")
  bankIfsc           String?            @map("bank_ifsc")

  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kycClientId])
  @@map("artist_profiles")
}
