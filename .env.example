NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# Neon: pooled for the app (host has -pooler). Direct for Prisma migrate (no -pooler).
DATABASE_URL=
DIRECT_URL=

# Long random string (at least 16 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Static OTP for account verification until the email OTP service is added.
# When STATIC_OTP_ENABLED=true, STATIC_OTP (6 digits) is required. Keep it false in production.
STATIC_OTP_ENABLED=false
STATIC_OTP=
