NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Long random string (at least 16 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Static OTP for account verification until the email OTP service is added.
# When STATIC_OTP_ENABLED=true, STATIC_OTP (6 digits) is required. Keep it false in production.
STATIC_OTP_ENABLED=false
STATIC_OTP=

# Public URL of this API (ngrok/localtunnel in dev) so Surepass can POST webhooks.
PUBLIC_API_URL=http://localhost:8000

# Surepass Digilocker Via Link (sandbox by default)
# Token from Surepass dashboard / sales — Authorization: Bearer <token>
SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_API_TOKEN=
# Frontend page Digilocker redirects to after the user finishes
SUREPASS_REDIRECT_URL=http://localhost:8081/artist/kyc/callback
# Optional; defaults to ${PUBLIC_API_URL}/api/v1/webhooks/surepass
SUREPASS_WEBHOOK_URL=
